<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.financelab</groupId><artifactId>build-parent</artifactId><version>0.1.0</version><relativePath>../../build-support/build-parent-0.1.0.pom</relativePath></parent>
    <artifactId>budget-ui-verification</artifactId>
    <packaging>war</packaging>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <vaadin.version>25.3.5</vaadin.version>
        <vaadin.ci.build>true</vaadin.ci.build>
    </properties>
    <dependencies>
        <dependency><groupId>org.financelab</groupId><artifactId>budget</artifactId><version>0.1.0</version></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><version>6.1.0</version><scope>provided</scope></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><version>13.12.0</version></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><version>13.12.0</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
        <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>1.64.0</version><scope>test</scope></dependency>
    </dependencies>
    <build><finalName>budget-ui-test</finalName><plugins>
        <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.4</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <configuration><argLine>-Xmx256m -Duser.timezone=Pacific/Honolulu</argLine></configuration>
        </plugin>
        <plugin><groupId>com.vaadin</groupId><artifactId>vaadin-maven-plugin</artifactId><version>${vaadin.version}</version>
            <configuration><forceProductionBuild>true</forceProductionBuild><nodeVersion>v24.22.2</nodeVersion>
                <reactEnable>false</reactEnable><cleanFrontendFiles>false</cleanFrontendFiles>
            </configuration>
            <executions><execution><goals><goal>prepare-frontend</goal><goal>build-frontend</goal></goals></execution></executions>
        </plugin>
    </plugins></build>
</project>
